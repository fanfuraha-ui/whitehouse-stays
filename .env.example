# Copy to .env and fill in. Never commit .env.
DOMAIN=whitehouseairbnb.co.ke
SITE_URL=https://whitehouseairbnb.co.ke
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=whitehouseairbnb.co.ke,www.whitehouseairbnb.co.ke

POSTGRES_DB=whitehouse
POSTGRES_USER=whitehouse
POSTGRES_PASSWORD=change-me

# Paystack (Settings → API Keys & Webhooks). Use test keys first.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

BOOKING_HOLD_MINUTES=15
TAX_RATE=0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Whitehouse Airbnb <bookings@whitehouseairbnb.co.ke>
STAFF_ALERT_EMAILS=owner@example.com
